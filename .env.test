# Isolated test environment. Never point these at production.
# Pytest conftest sets equivalent values; this file documents the contract.

# true = run Postgres/Redis tests locally. CI sets this false via GitHub secret.
RUN_INFRA_TESTS=true

DATABASE_URL=postgresql+psycopg2://devsecops:devsecops@localhost:5544/devsecops_test
REDIS_URL=redis://localhost:6399/1
AUTH_JWT_SECRET=test-jwt-secret-not-for-production
AUTH_USERNAME=test-admin
AUTH_PASSWORD=test-password-12
AUTH_DISPLAY_NAME=Test Admin
AUTH_VERIFY_DB=false
EXECUTOR_SERVICE_KEY=test-executor-key
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SMTP_HOST=
