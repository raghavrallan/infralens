# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database, app secret, and Azure CLI profiles
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local process pid files and logs from scripts/start-suite.sh
.local-run/
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal

# python skills engine
__pycache__/
*.py[cod]
.venv/
venv/
htmlcov/
.coverage
coverage.xml
.pytest_cache/
.mypy_cache/
