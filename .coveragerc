[run]
branch = True
source = app,executors
omit =
    */__pycache__/*
    tests/*
    scripts/*
    frontend/*
    .venv/*
    */.venv/*

[report]
show_missing = True
skip_covered = False
fail_under = 90
exclude_lines =
    pragma: no cover
    if __name__ == ["']__main__["']:
    raise NotImplementedError
    if TYPE_CHECKING:

[html]
directory = htmlcov
