# Infrastructure configuration only.
# Azure OpenAI and cloud/GitHub credentials are configured in the Settings page
# and stored in Postgres — NOT here.

# Connection string for the Postgres database (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://devsecops:devsecops@localhost:5544/devsecops

# Redis connection for the Intelligence Layer job queue (matches docker-compose.yml).
REDIS_URL=redis://localhost:6399/0

# Isolated provider executor control-plane settings. Action permissions are
# selected in the project-scoped UI, never by a process-wide feature flag.
EXECUTOR_SERVICE_KEY=dev-executor-key
CONTROL_PLANE_URL=http://127.0.0.1:8000
# Which org's Redis queues THESE executor containers listen to.
# Not a global lock: other orgs still enqueue jobs; they need their own
# executor pool with a different EXECUTOR_ORG_ID (UI: Organizations → Executor capacity).
# Must match organizations.id in Postgres (default seeded org below).
EXECUTOR_ORG_ID=00000000-0000-4000-8000-000000000001

# Org executor scale backend: omit for local Docker stub, or set aca for Azure.
# ORG_EXECUTOR_SCALE_BACKEND=local
# ACA_RESOURCE_GROUP=
# ACA_ENVIRONMENT=
# ACA_EXECUTOR_IMAGE_PREFIX=eqacrregistrydeveastus001.azurecr.io/devsecops-suite
# ACA_EXECUTOR_IMAGE_TAG=latest
# CONTROL_PLANE_INTERNAL_URL=http://api:8000

# Optional: server host/port
APP_HOST=127.0.0.1
APP_PORT=8000

# Host ports published by docker compose (override on shared servers)
POSTGRES_HOST_PORT=5544
REDIS_HOST_PORT=6399
API_HOST_PORT=8000

# Next.js live-dev UI (start-local.ps1 start uses next dev here)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
DEV_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Bootstrap seed ONLY when the users table is empty. After first boot, login
# uses the hashed password in Postgres — changing these does not change login
# unless you re-seed / reset the user. Prefer changing password in the UI/DB.
AUTH_USERNAME=admin
AUTH_PASSWORD=infralens
AUTH_DISPLAY_NAME=Admin
# Required process secret for signing JWTs (never store in DB). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-in-production

# Optional: re-check users table on every request (adds a DB RTT). Default off —
# JWT claims are trusted until expiry. Set true when immediate revoke is required.
# AUTH_VERIFY_DB=false
# AUTH_USER_CACHE_TTL=60

# SMTP for org invites and membership-approval emails
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT=8
PUBLIC_APP_URL=http://127.0.0.1:3000

# GitHub OAuth App (SSO) — create at GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL must be:
#   http://127.0.0.1:8000/api/providers/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Azure OAuth (optional)
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET=
# AZURE_OAUTH_TENANT_ID=

# Langfuse observability (session + user tracing, prompt management)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# Optional: production | staging | development (keeps test traces off prod dashboards)
LANGFUSE_TRACING_ENVIRONMENT=development
