# Optional. If unset, the server creates data/app-secret on first use.
# Changing this makes stored Azure client secrets unreadable.
APP_SECRET=

# Optional override for the SQLite file.
INFRALENS_DB=

# Optional path to Azure CLI's python.exe when `az` is not on PATH.
AZURE_CLI_PYTHON=

# Skills suite (FastAPI on port 8000). Azure OpenAI and cloud account
# secrets are stored in Postgres from Suite settings, not in this file.
DATABASE_URL=postgresql+psycopg2://devsecops:devsecops@localhost:5544/devsecops
REDIS_URL=redis://localhost:6399/0
APP_HOST=127.0.0.1
APP_PORT=8000
POSTGRES_HOST_PORT=5544
REDIS_HOST_PORT=6399

# Isolated provider executor control-plane settings.
EXECUTOR_SERVICE_KEY=dev-executor-key
CONTROL_PLANE_URL=http://127.0.0.1:8000
# Must match organizations.id in Postgres (default seeded org).
EXECUTOR_ORG_ID=00000000-0000-4000-8000-000000000001
# ORG_EXECUTOR_SCALE_BACKEND=local
# ACA_RESOURCE_GROUP=
# ACA_ENVIRONMENT=
# ACA_EXECUTOR_IMAGE_PREFIX=
# ACA_EXECUTOR_IMAGE_TAG=latest
# CONTROL_PLANE_INTERNAL_URL=http://api:8000

# Bootstrap seed ONLY when the users table is empty.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_DISPLAY_NAME=Admin
# Required process secret for signing JWTs. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-in-production
# AUTH_VERIFY_DB=false
# AUTH_USER_CACHE_TTL=60

# SMTP for sign-in codes and organization invites. Office 365 uses STARTTLS on 587.
# Office 365 (smtp.office365.com) is sent over Microsoft Graph on port 443.
# Other hosts use SMTP on SMTP_PORT.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=No Reply
SMTP_TIMEOUT=20
# Live Next app (npm run dev --port 3001).
PUBLIC_APP_URL=http://127.0.0.1:3001

# GitHub OAuth App. Callback:
#   http://127.0.0.1:8000/api/providers/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Azure OAuth (optional)
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET=
# AZURE_OAUTH_TENANT_ID=

# Langfuse. Optional. The API still starts if the host is unreachable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TIMEOUT=3
LANGFUSE_PROMPT_FETCH_TIMEOUT=3
LANGFUSE_TRACING_ENVIRONMENT=development
